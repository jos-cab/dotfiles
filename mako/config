# ~/dotfiles/mako/config

# Global configuration
max-history=5
sort=-time
icons=1
markup=1
history=1
group-by=app-name
output=""
layer=top
anchor=top-right
default-timeout=5000

# Style configuration
# Catppuccin Mocha Theme
background-color=#272a2eFF
text-color=#d8dee0FF
border-color=#81757dee
border-size=2
border-radius=12
padding=10
margin=10
width=300
height=100
