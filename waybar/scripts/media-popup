#!/usr/bin/env python3
import os
import subprocess
import tempfile
import threading
from urllib.request import urlopen

import gi

gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GdkPixbuf, GLib, Gtk, GtkLayerShell


def playerctl(*args):
    try:
        return subprocess.check_output(
            ["playerctl", *args], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except subprocess.CalledProcessError:
        return ""


def metadata():
    values = playerctl(
        "metadata",
        "--format",
        "{{title}}\\t{{artist}}\\t{{mpris:artUrl}}\\t{{mpris:length}}\\t{{playerName}}",
    )
    return (values.split("\\t", 4) + [""] * 5)[:5]


def command(*args):
    subprocess.run(
        ["playerctl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )


class PlayerPopup(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 10)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, 120)
        self.set_title("Media controls")
        self.set_default_size(420, 150)
        self.set_size_request(420, 150)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_type_hint(3)
        self.connect("destroy", Gtk.main_quit)
        self.dragging = False
        self.art_url = ""
        self.art_path = os.path.join(tempfile.gettempdir(), "waybar-mpris-art")

        css = Gtk.CssProvider()
        css.load_from_data(
            b"window { background: #1e1e2e; color: #cdd6f4; border: 2px solid #cba6f7; border-radius: 14px; } button { background: #313244; color: #cdd6f4; border-radius: 8px; } scale trough { background: #45475a; min-height: 6px; } scale highlight { background: #cba6f7; } scale slider { background: #cdd6f4; border: 0; }"
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gtk.Window.get_screen(self), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        root.set_border_width(14)
        self.add(root)

        self.art = Gtk.Image()
        self.art.set_size_request(112, 112)
        root.pack_start(self.art, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.pack_start(body, True, True, 0)
        self.title = Gtk.Label(xalign=0)
        self.title.set_width_chars(34)
        self.title.set_max_width_chars(34)
        self.title.set_ellipsize(3)
        self.artist = Gtk.Label(xalign=0)
        self.artist.set_width_chars(34)
        self.artist.set_max_width_chars(34)
        self.artist.set_ellipsize(3)
        body.pack_start(self.title, False, False, 0)
        body.pack_start(self.artist, False, False, 0)

        self.progress = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        self.progress.set_draw_value(False)
        self.progress.connect("button-press-event", self.begin_seek)
        self.progress.connect("button-release-event", self.end_seek)
        body.pack_start(self.progress, False, False, 0)

        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        body.pack_start(controls, False, False, 0)
        self.previous = Gtk.Button(label="󰒮")
        self.play = Gtk.Button(label="󰐊")
        self.next = Gtk.Button(label="󰒭")
        self.previous.connect("clicked", lambda _: command("previous"))
        self.play.connect("clicked", lambda _: command("play-pause"))
        self.next.connect("clicked", lambda _: command("next"))
        for button in (self.previous, self.play, self.next):
            controls.pack_start(button, True, True, 0)
        self.show_all()
        GLib.idle_add(self.update)
        GLib.timeout_add(500, self.update)

    def begin_seek(self, _, event):
        self.dragging = event.button == 1
        return False

    def end_seek(self, widget, event):
        if self.dragging and event.button == 1:
            length = float(playerctl("metadata", "--format", "{{mpris:length}}") or 0) / 1000000
            if length > 0:
                command("position", str(widget.get_value()))
        self.dragging = False
        return False

    def update(self):
        title, artist, art_url, raw_length, player = metadata()
        status = playerctl("status")
        self.play.set_label("󰏤" if status == "Playing" else "󰐊")
        length = float(raw_length or 0) / 1000000
        position = float(playerctl("position") or 0)
        self.title.set_text(title or "Nothing playing")
        self.artist.set_text(artist or player)
        self.progress.set_range(0, length or 1)
        if not self.dragging:
            self.progress.set_value(min(position, length) if length else 0)
        if art_url.startswith("file://"):
            path = art_url[7:]
            if os.path.exists(path):
                self.art.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 112, 112, True))
        elif art_url.startswith("http") and art_url != self.art_url:
            self.art_url = art_url
            threading.Thread(target=self.load_art, args=(art_url,), daemon=True).start()
        return True

    def load_art(self, art_url):
        try:
            data = urlopen(art_url, timeout=2).read()
            with open(self.art_path, "wb") as image:
                image.write(data)
            GLib.idle_add(self.set_art)
        except Exception:
            pass

    def set_art(self):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.art_path, 112, 112, True)
            self.art.set_from_pixbuf(pixbuf)
        except Exception:
            pass
        return False


if __name__ == "__main__":
    PlayerPopup()
    Gtk.main()
