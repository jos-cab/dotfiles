{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  "height": 52,
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "exclusive": false,
  "passthrough": false,
  "spacing": 6,
  "modules-left": [
    "custom/launcher",
    "custom/terminal",
    "custom/files",
    "custom/browser",
    "custom/discord",
    "custom/spotify"
  ],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["custom/power"],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": "Aplicaciones",
    "on-click": "wofi --show drun"
  },
  "custom/terminal": {
    "format": "󰆍",
    "tooltip": "Terminal",
    "on-click": "kitty"
  },
  "custom/files": {
    "format": "󰉋",
    "tooltip": "Archivos",
    "on-click": "thunar"
  },
  "custom/browser": {
    "format": "󰖟",
    "tooltip": "Brave",
    "on-click": "brave --ozone-platform=wayland --enable-features=UseOzonePlatform --password-store=basic --profile-directory=Default"
  },
  "custom/discord": {
    "format": "󰙯",
    "tooltip": "Discord",
    "on-click": "discord"
  },
  "custom/spotify": {
    "format": "󰓇",
    "tooltip": "Spotify",
    "on-click": "spotify-launcher"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 28,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "all-outputs": false
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": "Power Menu",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
