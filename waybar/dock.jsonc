{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  "width": 0,
  "margin-bottom": 10,
  "exclusive": false,
  "passthrough": false,
  "spacing": 6,
  "modules-center": [
    "custom/terminal",
    "custom/files",
    "custom/browser",
    "custom/discord",
    "custom/spotify"
  ],
  "custom/terminal": {
    "format": "󰆍",
    "tooltip": "Terminal",
    "on-click": "kitty"
  },
  "custom/files": {
    "format": "󰉋",
    "tooltip": "Archivos",
    "on-click": "thunar"
  },
  "custom/browser": {
    "format": "󰖟",
    "tooltip": "Brave",
    "on-click": "brave --ozone-platform=wayland --enable-features=UseOzonePlatform --password-store=basic --profile-directory=Default"
  },
  "custom/discord": {
    "format": "󰙯",
    "tooltip": "Discord",
    "on-click": "discord"
  },
  "custom/spotify": {
    "format": "󰓇",
    "tooltip": "Spotify",
    "on-click": "spotify-launcher"
  }
}
