#!/bin/bash

# Script to adjust Hyprland gaps
# Usage: adjust_gaps.sh <gaps_type> <operation>
# gaps_type: "out" or "in"
# operation: "inc" or "dec"

GAPS_TYPE=$1
OPERATION=$2
ADJUSTMENT=1

if [ "$GAPS_TYPE" = "out" ]; then
    OPTION="general:gaps_out"
    CURRENT=$(hyprctl getoption "$OPTION" | sed -n 's/^css gap data: \([0-9-]*\).*/\1/p')
elif [ "$GAPS_TYPE" = "in" ]; then
    OPTION="general:gaps_in"
    CURRENT=$(hyprctl getoption "$OPTION" | sed -n 's/^css gap data: \([0-9-]*\).*/\1/p')
elif [ "$GAPS_TYPE" = "border" ]; then
    OPTION="general:border_size"
    CURRENT=$(hyprctl getoption "$OPTION" | sed -n 's/^int: \([0-9-]*\).*/\1/p')
elif [ "$GAPS_TYPE" = "rounding" ]; then
    OPTION="decoration:rounding"
    SECTION="decoration"
    KEY="rounding"
    CURRENT=$(hyprctl getoption "$OPTION" | sed -n 's/^int: \([0-9-]*\).*/\1/p')
else
    echo "Invalid adjustment type. Use 'out', 'in', 'border', or 'rounding'"
    exit 1
fi

if [ -z "$CURRENT" ]; then
    echo "Could not read current value for $OPTION"
    exit 1
fi

if [ "$OPERATION" = "inc" ]; then
    NEW_VALUE=$((CURRENT + ADJUSTMENT))
elif [ "$OPERATION" = "dec" ]; then
    NEW_VALUE=$((CURRENT - ADJUSTMENT))
else
    echo "Invalid operation. Use 'inc' or 'dec'"
    exit 1
fi

if [ "$GAPS_TYPE" = "border" ] || [ "$GAPS_TYPE" = "rounding" ]; then
    if [ "$NEW_VALUE" -lt 0 ]; then
        NEW_VALUE=0
    fi
fi

# Apply new value
if [ "$GAPS_TYPE" = "rounding" ]; then
    hyprctl eval "hl.config({ decoration = { rounding = $NEW_VALUE } })"
else
    hyprctl eval "hl.config({ general = { ${OPTION#general:} = $NEW_VALUE } })"
fi