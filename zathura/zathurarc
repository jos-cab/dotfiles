# Zathura configuration file
# Using Catppuccin Mocha color scheme from dotfiles

# Default settings
set selection-clipboard clipboard
set adjust-open "width"
set zoom-min 10
set zoom-max 500

# Hide status bar at bottom
set statusbar-h-padding 0
set statusbar-v-padding 0
set statusbar-basename true
set guioptions ""

# Default fit mode (fit width like 's' keybind)
set adjust-open "width"

# Recolor settings (for dark mode)
set recolor true
set recolor-keephue true
set recolor-reverse-video true

# Color scheme - Catppuccin Mocha
# Based on colors from kitty config and hyprland appearance

# Background and foreground
set default-bg "#272a2e"  # Base
set default-fg "#d8dee0"  # Text

# Recolor (dark mode) - optimized for Catppuccin Mocha
set recolor-lightcolor "#272a2e"  # Base (background) - darker for better contrast
set recolor-darkcolor "#d8dee0"   # Rosewater (foreground) - warmer white for easier reading

# Selection colors
set highlight-color "#4b565d"     # Rosewater
set highlight-active-color "#aaa7a0"  # Rosewater
set highlight-fg "#aaa7a0"    # Rosewater

# Status bar colors
set statusbar-fg "#d8dee0"        # Text
set statusbar-bg "#30363b"        # Surface0

# Notification/error colors
set notification-bg "#9b6266"     # Red
set notification-fg "#272a2e"     # Base
set notification-error-bg "#9b6266"  # Red
set notification-error-fg "#272a2e"  # Base
set notification-warning-bg "#a69d7d"  # Yellow
set notification-warning-fg "#272a2e"  # Base

# Input bar colors
set inputbar-bg "#30363b"         # Surface0
set inputbar-fg "#d8dee0"         # Text

# Completion colors
set completion-bg "#39464e"       # Surface1
set completion-fg "#d8dee0"       # Text
set completion-highlight-bg "#62727a"  # Blue
set completion-highlight-fg "#272a2e"  # Base

# Index mode colors
set index-bg "#272a2e"            # Base
set index-fg "#d8dee0"            # Text
set index-active-bg "#62727a"     # Blue
set index-active-fg "#272a2e"     # Base

# Render colors (for transparency effects)
set render-loading-bg "#272a2e"   # Base
set render-loading-fg "#d8dee0"   # Text
#Additional settings for better UX
set scroll-step 50
set scroll-hstep -1
set scroll-wrap false
set advance-pages-per-row false
set continuous-hist-save true

# Link highlighting improvements
set link-zoom true
set link-hadjust true
set search-hadjust true

# Window settings
set window-title-basename true
set window-title-page false
