#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
THEME_FILE="${1:-$ROOT_DIR/themes/catppuccin-mocha.conf}"
[ -f "$THEME_FILE" ] || { printf 'Theme not found: %s\n' "$THEME_FILE" >&2; exit 1; }

THEME_FILES=(
    "$ROOT_DIR/hyprland/appearance.lua" "$ROOT_DIR/kitty/colors.conf"
    "$ROOT_DIR/kitty/fonts.conf" "$ROOT_DIR/kitty/window.conf"
    "$ROOT_DIR/waybar/style.css" "$ROOT_DIR/waybar/dock.css"
    "$ROOT_DIR/wofi/style.css" "$ROOT_DIR/mako/config" "$ROOT_DIR/zathura/zathurarc"
    "$ROOT_DIR/hyprland/scripts/capture-selection"
    "$ROOT_DIR/waybar/scripts/media-popup"
    "$ROOT_DIR/nvim/lua/plugins/colorscheme.lua"
    "$ROOT_DIR/imv/config"
)

spicetify_theme="$HOME/.config/spicetify/Themes/dotfiles"
spicetify_template="$ROOT_DIR/themes/templates/spicetify"
templates=(
    "$ROOT_DIR/themes/templates/hyprland_appearance.lua"
    "$ROOT_DIR/themes/templates/kitty_colors.conf"
    "$ROOT_DIR/themes/templates/kitty_fonts.conf"
    "$ROOT_DIR/themes/templates/kitty_window.conf"
    "$ROOT_DIR/themes/templates/waybar_style.css"
    "$ROOT_DIR/themes/templates/waybar_dock.css"
    "$ROOT_DIR/themes/templates/wofi_style.css"
    "$ROOT_DIR/themes/templates/mako_config"
    "$ROOT_DIR/themes/templates/zathura_zathurarc"
    "$ROOT_DIR/themes/templates/capture-selection"
    "$ROOT_DIR/themes/templates/media-popup"
    "$ROOT_DIR/themes/templates/nvim_colorscheme.lua"
    "$ROOT_DIR/themes/templates/imv_config"
)
old=(1e1e2e 181825 11111b 313244 45475a 585b70 cdd6f4 a6adc8 bac2de 6c7086 f5e0dc f2cdcd f5c2e7 cba6f7 f38ba8 eba0ac fab387 f9e2af a6e3a1 94e2d5 89dceb 74c7ec 89b4fa b4befe)
theme_name=$(basename "$THEME_FILE" .conf)
font_name="${DOTFILES_FONT:-JetBrainsMono Nerd Font}"
mapfile -t new < <(awk -F '=' '{value=$2; gsub(/[[:space:]#]/, "", value); print tolower(value)}' "$THEME_FILE")
base_rgb=$(printf '%d, %d, %d' "0x${new[0]:0:2}" "0x${new[0]:2:2}" "0x${new[0]:4:2}")

for i in "${!THEME_FILES[@]}"; do
    file="${THEME_FILES[$i]}"
    template="${templates[$i]}"
    [ -f "$template" ] || { printf 'Template not found: %s\n' "$template" >&2; exit 1; }
    generated=$(mktemp)
    cp "$template" "$generated"
    for color in "${!old[@]}"; do
        [ -n "${new[$color]:-}" ] || continue
        perl -0pi -e "s/rgba\(${old[$color]}/rgba(${new[$color]}/g; s/#${old[$color]}/#${new[$color]}/g" "$generated"
    done
    if [ "$file" = "$ROOT_DIR/imv/config" ]; then
        perl -0pi -e "s/__BASE__/${new[0]}/g; s/__SURFACE0__/${new[3]}/g; s/__TEXT__/${new[6]}/g" "$generated"
    fi
    if [ "$file" = "$ROOT_DIR/nvim/lua/plugins/colorscheme.lua" ]; then
        nvim_flavour=mocha
        [ "$theme_name" = "catppuccin-macchiato" ] &&         nvim_flavour=macchiato
        perl -0pi -e "s/__NVIM_FLAVOUR__/$nvim_flavour/g" "$generated"
        nvim_keys=(base mantle crust surface0 surface1 surface2 text subtext0 subtext1 overlay0 rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire blue lavender)
        for nvim_index in "${!nvim_keys[@]}"; do
            nvim_key="${nvim_keys[$nvim_index]}"
            nvim_value="${new[$nvim_index]}"
            perl -0pi -e "s/__${nvim_key^^}__/$nvim_value/g" "$generated"
        done
    fi
    if [ "$file" = "$ROOT_DIR/waybar/dock.css" ]; then
        perl -0pi -e "s/rgba\(30, 30, 46, 0\.60\)/rgba($base_rgb, 0.60)/g" "$generated"
    fi
    FONT_NAME="$font_name" perl -0pi -e 's/JetBrainsMono Nerd Font(?: Mono)?/$ENV{FONT_NAME}/g' "$generated"
    mv "$generated" "$file"
    case "$file" in
        "$ROOT_DIR/hyprland/scripts/capture-selection"|"$ROOT_DIR/waybar/scripts/media-popup") chmod +x "$file" ;;
    esac
done

for font_file in \
    "$ROOT_DIR/kitty/fonts.conf" \
    "$ROOT_DIR/waybar/style.css" \
    "$ROOT_DIR/waybar/dock.css" \
    "$ROOT_DIR/wofi/style.css" \
    "$ROOT_DIR/imv/config"; do
    [ -f "$font_file" ] || continue
    FONT_NAME="$font_name" perl -0pi -e 's/JetBrainsMono Nerd Font(?: Mono)?/$ENV{FONT_NAME}/g' "$font_file"
done

betterdiscord_theme="$HOME/.config/BetterDiscord/themes/midnight.theme.css"
betterdiscord_template="$ROOT_DIR/themes/templates/betterdiscord.theme.css"
if [ -f "$betterdiscord_template" ]; then
    generated=$(mktemp)
    cp "$betterdiscord_template" "$generated"
bd_old=(eceff4 e5e9f0 d8dee9 7f849c 616e88 434c5e 3b4252 272c36 2e3440 585b70)
bd_new=(6 6 6 10 10 4 3 1 0 2)
    for color in "${!bd_old[@]}"; do
        perl -0pi -e "s/#${bd_old[$color]}/#${new[${bd_new[$color]}]}/gi" "$generated"
    done
    perl -0pi -e "s/#bf616a/#${new[14]}/gi; s/#b48ead/#${new[13]}/gi; s/#a3be8c/#${new[18]}/gi; s/#81a1c1/#${new[22]}/gi; s/#88c0d0/#${new[20]}/gi; s/#ebcb8b/#${new[17]}/gi; s/#d08770/#${new[16]}/gi; s/#b38add/#${new[13]}/gi" "$generated"
    mkdir -p "$(dirname "$betterdiscord_theme")"
    mv "$generated" "$betterdiscord_theme"
    betterdiscord_themes="$HOME/.config/BetterDiscord/data/stable/themes.json"
    if command -v jq >/dev/null 2>&1 && [ -f "$betterdiscord_themes" ]; then
        temporary=$(mktemp)
        jq '.midnight = true' "$betterdiscord_themes" > "$temporary" && mv "$temporary" "$betterdiscord_themes"
    fi
fi

if command -v spicetify >/dev/null 2>&1 && [ -d "$HOME/.config/spicetify" ]; then
    rm -rf "$spicetify_theme"
    mkdir -p "$(dirname "$spicetify_theme")"
    cp -a "$spicetify_template" "$spicetify_theme"
    spicetify_colors="$spicetify_theme/color.ini"
    generated=$(mktemp)
    {
        printf '[Base]\n'
        printf 'text = %s\nsubtext = %s\nmain = %s\nmain-elevated = %s\nsidebar = %s\nplayer = %s\ncard = %s\ncard-background = %s\ncard-hover = %s\nshadow = %s\nselected-row = %s\nbutton = %s\nbutton-active = %s\nbutton-disabled = %s\ntab-active = %s\nnotification = %s\nnotification-error = %s\nmisc = %s\ngradientTop = %s\ngradientBottom = %s\nplay-hover = %s\ntopbar = %s\ntopbar-text = %s\n' \
            "${new[6]}" "${new[7]}" "${new[0]}" "${new[3]}" "${new[1]}" "${new[2]}" "${new[3]}" "${new[3]}" "${new[4]}" "${new[2]}" "${new[4]}" "${new[13]}" "${new[13]}" "${new[9]}" "${new[3]}" "${new[13]}" "${new[14]}" "${new[9]}" "${new[1]}" "${new[3]}" "${new[4]}" "${new[1]}" "${new[6]}"
    } > "$generated"
    mv "$generated" "$spicetify_colors"
    spicetify config current_theme dotfiles >/dev/null
    spicetify config color_scheme Base >/dev/null
    spicetify config inject_css 1 >/dev/null
    spicetify config inject_theme_js 0 >/dev/null
    spicetify config replace_colors 1 >/dev/null
    spicetify config overwrite_assets 1 >/dev/null
    spicetify apply >/dev/null
fi

vscode_theme="Catppuccin Mocha"

brave_preferences="$HOME/.config/BraveSoftware/Brave-Browser/Default/Preferences"
if [ -f "$brave_preferences" ] && command -v jq >/dev/null 2>&1; then
    temporary=$(mktemp)
    jq '.browser.theme = ((.browser.theme // {}) + {"is_dark": true})' "$brave_preferences" > "$temporary" && mv "$temporary" "$brave_preferences"
fi

vscode="$HOME/.config/Code/User/settings.json"
[ -f "$vscode" ] && perl -0pi -e 's/"workbench\.colorTheme"\s*:\s*"[^"]*"/"workbench.colorTheme": "Catppuccin Mocha"/; s/"workbench\.iconTheme"\s*:\s*"[^"]*"/"workbench.iconTheme": "material-icon-theme"/' "$vscode"

command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true
if command -v waybar >/dev/null 2>&1; then
    pkill -x waybar 2>/dev/null || true
    waybar >/dev/null 2>&1 &
    if [ -f "$HOME/.config/waybar/dock.jsonc" ] && [ -f "$HOME/.config/waybar/dock.css" ]; then
        waybar -c "$HOME/.config/waybar/dock.jsonc" -s "$HOME/.config/waybar/dock.css" >/dev/null 2>&1 &
    fi
fi
command -v makoctl >/dev/null 2>&1 && makoctl reload 2>/dev/null || true
printf 'Applied theme: %s\n' "$(basename "$THEME_FILE" .conf)"
