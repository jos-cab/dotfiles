#!/bin/bash

set -u

ACTION=${1:-screenshot}
IMAGE=$(mktemp --suffix=.png)

cleanup() {
    rm -f "$IMAGE"
}

notify() {
    notify-send "Selection capture" "$1"
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notify "$1 is not installed"
        exit 1
    fi
}

capture_selection() {
    SLURP_ARGS='-b #1e1e2e99 -s #00000000 -c #cba6f7ff -w 2' \
        grimblast --freeze save area "$IMAGE" || {
        notify "Failed to capture selection"
        exit 1
    }
}

trap cleanup EXIT

require_command grimblast
require_command wl-copy

case "$ACTION" in
    screenshot)
        capture_selection
        wl-copy --type image/png < "$IMAGE"
        notify "Screenshot copied to clipboard"
        ;;
    ocr)
        require_command tesseract
        capture_selection

        TEXT=$(tesseract "$IMAGE" stdout 2>/dev/null | sed -e 's/[[:space:]]*$//')

        if [ -z "$TEXT" ]; then
            notify "No text found"
            exit 1
        fi

        printf '%s' "$TEXT" | wl-copy
        notify "Text copied to clipboard"
        ;;
    qr)
        require_command zbarimg
        capture_selection

        RESULT=$(zbarimg --quiet --raw "$IMAGE" 2>/dev/null || true)

        if [ -z "$RESULT" ]; then
            notify "No QR code found"
            exit 1
        fi

        printf '%s' "$RESULT" | wl-copy
        notify "QR content copied to clipboard"
        ;;
    *)
        notify "Unknown action: $ACTION"
        exit 1
        ;;
esac
