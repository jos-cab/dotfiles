[options]
background = __BASE__
overlay_background_color = __SURFACE0__
overlay_background_alpha = c3
overlay_text_color = __TEXT__
overlay_text_alpha = ff
fullscreen = false
width = 1280
height = 720
scaling_mode = full
slideshow_duration = 0
loop_input = true
overlay = false
overlay_font = JetBrainsMono Nerd Font:12
overlay_position_bottom = false
title_text = imv
upscaling_method = linear

[binds]
<Right> = next
<Left> = prev
<Escape> = quit
<Space> = next
<BackSpace> = prev
q = quit
x = quit
f = fullscreen
h = overlay
